# Copy this file to ".env" and fill in your real values.
# NEVER commit ".env" to GitHub (it is listed in .gitignore).

PORT=3000
NODE_ENV=development

# --- TiDB Cloud (MySQL-compatible) ---
DATABASE_HOST=
DATABASE_PORT=4000
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=kingdom_crew
# TiDB Serverless uses a public CA, so you normally leave this empty.
# Only paste a CA certificate here if TiDB tells you your cluster needs one.
DATABASE_CA_CERT=

# --- AI assistant (any OpenAI-compatible API) ---
# Recommended free option: Groq. Create a key at console.groq.com (no card needed
# for the free tier). Keep it secret: it lives ONLY here and in Render's
# environment variables, never in public/ files.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
# If the main model is busy or over its daily limit, the server retries once with this one.
AI_FALLBACK_MODEL=llama-3.1-8b-instant

# Alternative free option: Google Gemini (key from aistudio.google.com)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-2.5-flash
# AI_FALLBACK_MODEL=gemini-2.5-flash-lite
# Model names change over time: check the provider's current model list.

# Optional: your GitHub Pages address, if the frontend is hosted there and the
# backend on Render (allows the browser to call the API). Example:
# ALLOWED_ORIGIN=https://yourname.github.io
ALLOWED_ORIGIN=
